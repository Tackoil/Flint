// Common macOS application settings. Feature selection lives in Features.xcconfig.
#include "Features.xcconfig"

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = dev.saming.flint
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Flint/Supporting/Info.plist
CODE_SIGN_ENTITLEMENTS = Flint/Supporting/Flint.entitlements
CODE_SIGNING_ALLOWED = YES
// Use ad hoc signing so local builds work without an Apple developer account.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
